/* RPGAPI_App changed layout with the settings added to it: programs     */
/* compiled against the earlier header have to be recompiled, so there   */
/* are no *PRV export lists for them to bind to                          */
     STRPGMEXP  PGMLVL(*CURRENT)
        EXPORT     SYMBOL('RPGAPI_START')
        EXPORT     SYMBOL('RPGAPI_GET')
        EXPORT     SYMBOL('RPGAPI_PUT')
        EXPORT     SYMBOL('RPGAPI_POST')
        EXPORT     SYMBOL('RPGAPI_DELETE')
        EXPORT     SYMBOL('RPGAPI_GETPARAM')
        EXPORT     SYMBOL('RPGAPI_GETQUERYPARAM')
        EXPORT     SYMBOL('RPGAPI_GETHEADER')
        EXPORT     SYMBOL('RPGAPI_SETHEADER')
        EXPORT     SYMBOL('RPGAPI_SETMIDDLEWARE')
        EXPORT     SYMBOL('RPGAPI_SETROUTE')
        EXPORT     SYMBOL('RPGAPI_PATCH')
        EXPORT     SYMBOL('RPGAPI_SETMAXREQUESTSIZE')
        EXPORT     SYMBOL('RPGAPI_BODYLENGTH')
        EXPORT     SYMBOL('RPGAPI_READBODY')
        EXPORT     SYMBOL('RPGAPI_READBODYBYTES')
        EXPORT     SYMBOL('RPGAPI_BEGINRESPONSE')
        EXPORT     SYMBOL('RPGAPI_WRITE')
        EXPORT     SYMBOL('RPGAPI_WRITEBYTES')
        EXPORT     SYMBOL('RPGAPI_ENDRESPONSE')
        EXPORT     SYMBOL('RPGAPI_SENDFILE')
        EXPORT     SYMBOL('RPGAPI_SETMAXUPLOADSIZE')
        EXPORT     SYMBOL('RPGAPI_SAVEBODY')
        EXPORT     SYMBOL('RPGAPI_NEXTPART')
        EXPORT     SYMBOL('RPGAPI_READPART')
        EXPORT     SYMBOL('RPGAPI_READPARTBYTES')
        EXPORT     SYMBOL('RPGAPI_SAVEPART')
        EXPORT     SYMBOL('RPGAPI_SETTLSAPPLICATION')
        EXPORT     SYMBOL('RPGAPI_SETTLSKEYSTORE')
        EXPORT     SYMBOL('RPGAPI_SETLOGLEVEL')
        EXPORT     SYMBOL('RPGAPI_SETTIMEOUTS')
        EXPORT     SYMBOL('RPGAPI_SETCORS')
     ENDPGMEXP
