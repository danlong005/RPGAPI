<%! /include 'people_t.rpgleinc'
     dcl-ds model likeds(people_t) based(RPGAPI_data);
     dcl-s i int(10:0); -%>
<% for i = 1 to model.count; -%>
<%= model.people(i).id %>|<%= model.people(i).name %>|<%= model.people(i).balance + 1 %>|<%= %char(model.people(i).since : *eur) %>
<% endfor; -%>
count=<%= model.count %>
