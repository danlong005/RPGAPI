<%! /include 'listpage_t.rpgleinc'
     dcl-ds model likeds(listpage_t) based(RPGAPI_data);
     dcl-s i int(10:0); -%>
<%# a page: a view for the heading, a view for each row, and text with quotes, a tab and umlauts -%>
<!DOCTYPE html>
<html><head><title><%= model.title %></title></head>
<body>
<% RPGAPI_include('heading.erpg' : %addr(model.title)); -%>
<ul>
<% for i = 1 to model.count; -%>
<%    RPGAPI_include('item.erpg' : %addr(model.items(i))); -%>
<% endfor; -%>
</ul>
<p>It's "quoted", a	tab, and Grüße</p>
<p>A literal <%% tag, and <%= '<b>&</b>' %> escaped, <%- '<b>raw</b>' %> not</p>
</body></html>
