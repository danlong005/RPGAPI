<%! dcl-ds item_t qualified template;
       id int(10:0);
       label varchar(100);
     end-ds;
     dcl-ds items likeds(item_t) dim(*var : 5000);
     dcl-ds item likeds(item_t); -%>
<%# a page: a view for the heading, a list, and text with quotes, a tab and umlauts -%>
<% items = RPGAPI_getList('items'); -%>
<!DOCTYPE html>
<html><head><title><%= RPGAPI_getVar('title') %></title></head>
<body>
<% RPGAPI_include('heading.erpg'); -%>
<ul>
<% for-each item in items; -%>
  <li id="row<%= item.id %>"><%= item.label %> of <%- %elem(items) %></li>
<% endfor; -%>
</ul>
<p>It's "quoted", a	tab, and Grüße</p>
<p>A literal <%% tag, and <%= '<b>&</b>' %> escaped, <%- '<b>raw</b>' %> not</p>
</body></html>
