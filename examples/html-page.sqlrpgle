**free
   // An HTML page from ERPG templates: the tables and views of a library, from
   // the SQL catalog. views/tablelist.erpg loops over an SQL cursor and calls
   // views/pagetop.erpg for the top of the page; ERPG turns each into a
   // procedure, which this program /includes. The page streams, so it can be
   // any length, and it is gzipped for browsers.
   //
   // Build (ERPG first, and again whenever a template changes):
   //   CALL PGM(MYLIB/ERPG) PARM('<clone>/examples/views/pagetop.erpg')
   //   CALL PGM(MYLIB/ERPG) PARM('<clone>/examples/views/tablelist.erpg')
   //   CRTSQLRPGI OBJ(MYLIB/HTMLPAGE) SRCSTMF('<clone>/examples/html-page.sqlrpgle')
   //              CVTCCSID(*JOB) RPGPPOPT(*LVL2) INCDIR('<clone>/qrpglesrc')
   //              COMPILEOPT('INCDIR(''<clone>/qrpglesrc'') TGTCCSID(*JOB)')
   //   RPGPPOPT(*LVL2) lets the SQL precompiler see the SQL in the views.
   // Run:
   //   SBMJOB CMD(CALL PGM(MYLIB/HTMLPAGE)) JOB(HTMLPAGE)
   // Try, in a browser:
   //   http://your-ibm-i:8080/tables/QSYS2

ctl-opt option(*nodebugio:*srcstmt) bnddir('RPGAPI') dftactgrp(*no);

/include 'rpgapi_h.rpgle'

dcl-ds app likeds(RPGAPI_App);

clear app;
RPGAPI_get(app : '/tables/{library}' : %paddr(tables));
RPGAPI_setCompression(app);
RPGAPI_start(app : 8080);

*inlr = *on;
return;


dcl-proc tables;
   dcl-pi *n likeds(RPGAPI_Response);
      request likeds(RPGAPI_Request) const;
   end-pi;
   dcl-ds response likeds(RPGAPI_Response) inz;

   RPGAPI_setHeader(response : 'Content-Type' : 'text/html; charset=utf-8');
   RPGAPI_beginResponse(response);
   tablelist(%upper(RPGAPI_getParam(request : 'library')));
   RPGAPI_endResponse();
   return response;
end-proc;

   // the views, generated by ERPG from views/*.erpg
/include 'views/pagetop.erpg.rpgle'
/include 'views/tablelist.erpg.rpgle'
