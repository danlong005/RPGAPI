<%# the top of every page: the head, and the title as a heading. Its data
    is the title: RPGAPI_include('pagetop.erpg' : %addr(model.title)) -%>
<%! dcl-s title varchar(100) based(RPGAPI_data); -%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title><%= title %></title>
<style>
  body { font-family: sans-serif; margin: 2em; }
  th, td { padding: 4px 12px; text-align: left; }
  tr:nth-child(even) { background: #f4f4f4; }
</style>
</head>
<body>
<h1><%= title %></h1>
