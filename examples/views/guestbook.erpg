<%# the guestbook: a form, what is wrong with the last one sent if there is
    something, and the notes, newest first -%>
<%! /include 'guestbook_t.rpgleinc'
     dcl-ds model likeds(guestbook_t) based(RPGAPI_data);
     dcl-s i int(10:0); -%>
<% RPGAPI_include('pagetop.erpg' : %addr(model.title)); -%>
<% if model.problem <> ''; -%>
<p style="color: #b00"><%= model.problem %></p>
<% endif; -%>
<form method="post" action="/guestbook">
  <p><label>Name <input name="name" maxlength="50"></label></p>
  <p><label>Message <textarea name="message" maxlength="500"></textarea></label></p>
  <p><button>Sign</button></p>
</form>
<% if model.count = 0; -%>
<p>No one has signed yet. Be the first!</p>
<% else; -%>
<p><%= model.count %> <% if model.count = 1; %>note<% else; %>notes<% endif; %> so far</p>
<% for i = 1 to model.count; -%>
<blockquote>
  <p><%= model.notes(i).message %></p>
  <footer>&mdash; <%= model.notes(i).name %>, <%= %date(model.notes(i).posted) %> at <%= %char(%time(model.notes(i).posted) : *hms:) %></footer>
</blockquote>
<% endfor; -%>
<% endif; -%>
</body>
</html>
