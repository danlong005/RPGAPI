**free
   // the data of views/guestbook.erpg, shared with guestbook.rpgle, which
   // fills it and renders the view: the same data structure on both sides
dcl-ds note_t qualified template;
   name varchar(50);
   message varchar(500);
   posted timestamp;
end-ds;
   // first, what the layout shows (layout_t.rpgleinc, included before this)
dcl-ds guestbook_t qualified template;
   head likeds(layout_t);
      // what is wrong with the form just sent, or ''
   problem varchar(100);
   count int(10:0);
      // newest first
   notes likeds(note_t) dim(100);
end-ds;
