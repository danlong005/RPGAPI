<%# the tables and views of a library: the list the route made from SQL -%>
<%! dcl-ds table_t qualified template;
       name varchar(128);
       kind varchar(20);
       text varchar(50);
       changed timestamp;
     end-ds;
     dcl-ds tables likeds(table_t) dim(*var : 5000);
     dcl-ds tbl likeds(table_t); -%>
<% tables = RPGAPI_getList('tables'); -%>
<% RPGAPI_include('pagetop.erpg'); -%>
<table>
  <tr><th>Name</th><th>Type</th><th>Description</th><th>Changed</th></tr>
<% for-each tbl in tables; -%>
  <tr><td><%= tbl.name %></td><td><%= tbl.kind %></td><td><%= tbl.text %></td><td><%= %date(tbl.changed) %></td></tr>
<% endfor; -%>
</table>
<p><%= %elem(tables) %> tables and views</p>
</body>
</html>
