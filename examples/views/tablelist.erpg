<%# the tables and views of a library, from the route's data structure,
    in views/layout.erpg -%>
<%! /include 'layout_t.rpgleinc'
     /include 'tablelist_t.rpgleinc'
     dcl-ds model likeds(tablelist_t) based(RPGAPI_data);
     dcl-s i int(10:0); -%>
<table>
  <tr><th>Name</th><th>Type</th><th>Description</th><th>Changed</th></tr>
<% for i = 1 to model.count; -%>
  <tr><td><%= model.tables(i).name %></td><td><%= model.tables(i).kind %></td><td><%= model.tables(i).text %></td><td><%= %date(model.tables(i).changed) %></td></tr>
<% endfor; -%>
</table>
<p><%= model.count %> tables and views</p>
