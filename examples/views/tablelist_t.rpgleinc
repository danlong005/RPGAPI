**free
   // the data of views/tablelist.erpg, shared with html-page.sqlrpgle, which
   // fills it and renders the view: the same data structure on both sides
dcl-ds table_t qualified template;
   name varchar(128);
   kind varchar(20);
   text varchar(50);
   changed timestamp;
end-ds;
   // first, what the layout shows (layout_t.rpgleinc, included before this)
dcl-ds tablelist_t qualified template;
   head likeds(layout_t);
   count int(10:0);
   tables likeds(table_t) dim(5000);
end-ds;
